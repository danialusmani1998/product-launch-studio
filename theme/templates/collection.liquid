{% comment %}
  Collection Template with Filters and Products
{% endcomment %}

{% seo %}

<div style="max-width: 1280px; margin: 0 auto; padding: 2rem 1rem;">
  {% include 'breadcrumb' %}

  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: 2.25rem; font-weight: 700; color: #1f2937; margin-bottom: 0.5rem;">{{ collection.title }}</h1>
    {% if collection.description %}
      <p style="color: #6b7280; font-size: 1.125rem; max-width: 800px;">{{ collection.description }}</p>
    {% endif %}
  </div>

  <div style="display: grid; grid-template-columns: 250px 1fr; gap: 2rem; margin-bottom: 3rem;">
    <!-- Filters Sidebar -->
    <aside>
      {% include 'filters' %}
    </aside>

    <!-- Products Grid -->
    <section>
      {% if collection.products.size > 0 %}
        <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
          <p style="color: #6b7280; font-weight: 600;">Showing {{ collection.products.size }} products</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2rem;">
          {% for product in collection.products %}
            {% include 'product-card' with product: product %}
          {% endfor %}
        </div>
      {% else %}
        <div style="text-align: center; padding: 3rem;">
          <p style="color: #6b7280; font-size: 1.125rem; margin-bottom: 1rem;">No products found</p>
          <a href="/collections/all" style="background: #10b981; color: white; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 700; transition: all 0.3s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
            Browse All Products
          </a>
        </div>
      {% endif %}
    </section>
  </div>
</div>

<script>
  if (window.injectCollectionSchema) {
    window.injectCollectionSchema({ title: '{{ collection.title }}', description: '{{ collection.description }}' }, {{ collection.products | json }});
  }
  if (window.injectBreadcrumbSchema) {
    window.injectBreadcrumbSchema([{ name: 'Home', url: '{{ shop.url }}' }, { name: '{{ collection.title }}', url: '{{ collection.url }}' }]);
  }
</script>
